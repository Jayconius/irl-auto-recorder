# Copy this file to .env and fill in SLS_API_KEY.

# API key from the srtla-receiver (the one the management web UI asks for).
# With it, every stream profile is recorded automatically, including brand new ones.
SLS_API_KEY=

# Where recordings go on this machine.
RECORDINGS_PATH=/home/youruser/recordings

# Your user and group IDs (run `id -u` and `id -g`), so recordings are owned by you.
PUID=1000
PGID=1000

# The receiver's stats/API port (SLS_STATS_PORT in the receiver's .env) and player port
# (SRT_PLAYER_PORT). The defaults match a standard srtla-receiver install.
STATS_URL=http://127.0.0.1:8080
SRT_PLAYER=127.0.0.1:4000

# Length of each recording file in seconds (900 = 15 min)
SEGMENT_SECONDS=900
# Keep a recording going through drops of up to this many seconds
GRACE_SECONDS=90
# Profiles never to record, comma separated
# EXCLUDE_STREAM_IDS=play_test,play_other

# Disk cleanup: delete the oldest recordings when the disk gets this full (0 = off)
CLEANUP_START_PERCENT=85
CLEANUP_TARGET_PERCENT=75
